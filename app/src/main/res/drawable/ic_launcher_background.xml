<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF05060A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.44"
                android:endColor="#FF05060A"
                android:gradientRadius="78dp"
                android:startColor="#FF273040"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#1AFE2C55"
                android:startColor="#1A25F4EE" />
        </shape>
    </item>
</layer-list>
