<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/crashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/crashScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="上次启动出错了"
                android:textColor="@color/white"
                android:textSize="25sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="把下面的日志分享给开发者，就能定位是哪台手机、什么视频、哪一步出的问题。"
                android:textColor="@color/white_70"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/crashText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:textColor="@color/white_70"
                android:textIsSelectable="true"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/crashShare"
                style="@style/PillButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="分享日志" />

            <TextView
                android:id="@+id/crashCopy"
                style="@style/PillButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="复制日志" />

            <TextView
                android:id="@+id/crashClear"
                style="@style/PillButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="清除日志并进入 App" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="也可以直接截图这一页发给我"
                android:textColor="@color/muted_dark"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
