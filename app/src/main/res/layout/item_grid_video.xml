<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="2dp"
    android:background="@color/search_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_grid_image"
        android:clipToOutline="true">

        <com.xiazongji.littlestar.AspectImageView
            android:id="@+id/gridThumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.92"
            android:contentDescription="@null"
            android:shadowColor="#66000000"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:src="@drawable/ic_play_small" />

        <TextView
            android:id="@+id/gridDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="7dp"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/gridTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:text="小视频"
        android:textColor="@color/grid_text"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:background="@drawable/bg_grid_avatar"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@drawable/ic_baby"
            android:tint="#FF9A9AA2" />

        <TextView
            android:id="@+id/gridAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/grid_author"
            android:textColor="@color/grid_muted"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_heart"
            android:tint="#FF9A9AA2" />

        <TextView
            android:id="@+id/gridMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="2214"
            android:textColor="@color/grid_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
